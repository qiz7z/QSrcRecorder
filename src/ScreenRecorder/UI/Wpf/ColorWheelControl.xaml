<UserControl x:Class="ScreenRecorder.UI.Wpf.ColorWheelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="236" Height="112">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="92"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 色环 -->
        <Image x:Name="WheelImage" Grid.Column="0" Width="92" Height="92"
               Cursor="Hand" MouseLeftButtonDown="Wheel_MouseDown" MouseMove="Wheel_MouseMove"
               MouseLeftButtonUp="Wheel_MouseUp"/>

        <!-- 亮度条 -->
        <Border Grid.Column="2" Width="14" Height="92" CornerRadius="7" Cursor="Hand"
                BorderBrush="#E2E8F0" BorderThickness="1"
                MouseLeftButtonDown="Brightness_MouseDown" MouseMove="Brightness_MouseMove"
                MouseLeftButtonUp="Brightness_MouseUp">
            <Grid>
                <Border x:Name="BrightnessGradient" CornerRadius="6"/>
                <Border x:Name="BrightnessThumb" Width="18" Height="6" CornerRadius="3"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        BorderBrush="White" BorderThickness="2">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.5"/>
                    </Border.Effect>
                </Border>
            </Grid>
        </Border>

        <!-- 预览 + hex -->
        <StackPanel Grid.Column="3" Margin="10,8,0,0">
            <Border x:Name="PreviewBox" Width="30" Height="30" CornerRadius="6"
                    BorderBrush="#E2E8F0" BorderThickness="1"
                    HorizontalAlignment="Left"/>
            <TextBlock x:Name="HexText" FontSize="11" Foreground="#475569" Margin="0,6,0,0"
                       FontFamily="Consolas"/>
        </StackPanel>
    </Grid>
</UserControl>
