<Window x:Class="ScreenRecorder.UI.Wpf.WindowPickerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QSrcRecorder · 选择窗口" Width="640" Height="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize"
        ShowInTaskbar="False" Icon="/Assets/QSrcRecorder.ico"
        Background="#FFFFFF" FontFamily="Segoe UI"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <!-- 与主窗体一致的设计 token -->
        <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#475569"/>
        <SolidColorBrush x:Key="TextTertiary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="Brand" Color="#DC2626"/>
        <SolidColorBrush x:Key="BrandHover" Color="#B91C1C"/>
        <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentSubtle" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="FieldBorder" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="HoverBg" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="CardBorder" Color="#FAE4E4"/>

        <!-- 次级按钮 -->
        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBg}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮（品牌红） -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="{StaticResource Brand}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrandHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 列表行：悬停浅底、选中蓝边蓝字 -->
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6"
                                Padding="10,0" Margin="0,1">
                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                  Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSubtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题行 -->
        <DockPanel>
            <TextBlock Text="选择要录制的窗口" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}"/>
            <TextBlock x:Name="CountText" FontSize="12" Foreground="{StaticResource TextTertiary}"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </DockPanel>

        <!-- 窗口列表 -->
        <Border Grid.Row="1" Margin="0,14,0,0" BorderBrush="{StaticResource FieldBorder}"
                BorderThickness="1" CornerRadius="8" Background="White">
            <ListView x:Name="WindowList" BorderThickness="0" Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      MouseDoubleClick="WindowList_MouseDoubleClick" KeyDown="WindowList_KeyDown">
                <ListView.View>
                    <GridView AllowsColumnReorder="False">
                        <GridViewColumn Header="窗口标题" Width="430" DisplayMemberBinding="{Binding Title}"/>
                        <GridViewColumn Header="进程" Width="140" DisplayMemberBinding="{Binding ProcessName}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- 底部按钮 -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button Style="{StaticResource BtnPrimary}" DockPanel.Dock="Right" Width="88"
                    Content="确定" Click="Ok_Click"/>
            <Button Style="{StaticResource BtnSecondary}" DockPanel.Dock="Right" Width="88"
                    Content="刷新" Margin="0,0,10,0" Click="Refresh_Click"/>
        </DockPanel>
    </Grid>
</Window>
