<Window x:Class="ScreenRecorder.UI.Wpf.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:ScreenRecorder.UI.Wpf"
        Title="QSrcRecorder" Width="960" Height="540"
        WindowStyle="None" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/QSrcRecorder.ico"
        Background="#05070C" FontFamily="Times New Roman, 华文中宋"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <!-- 设计 token（ui-ux-pro-max：Swiss Minimalism · 录制红 + 波形蓝） -->
        <SolidColorBrush x:Key="TextPrimary" Color="#E7F6FF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9FB6C9"/>
        <SolidColorBrush x:Key="TextTertiary" Color="#6E879C"/>
        <SolidColorBrush x:Key="Brand" Color="#22D3EE"/>
        <SolidColorBrush x:Key="BrandHover" Color="#67E8F9"/>
        <SolidColorBrush x:Key="Accent" Color="#22D3EE"/>
        <SolidColorBrush x:Key="AccentSubtle" Color="#142833"/>
        <SolidColorBrush x:Key="CardBorder" Color="#5538E8FF"/>
        <SolidColorBrush x:Key="FieldBorder" Color="#334155"/>
        <SolidColorBrush x:Key="FieldBg" Color="#CC0C141C"/>
        <SolidColorBrush x:Key="HoverBg" Color="#E014222C"/>
        <SolidColorBrush x:Key="Panel" Color="#C00B1016"/>

        <!-- 卡片容器 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.35" Color="#22D3EE"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- 字段标签 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="2,0,0,2"/>
        </Style>

        <!-- 下拉框（完整重写模板：圆角/悬停/弹出层带投影） -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                                CornerRadius="6">
                                            <Path Data="M0,0 L4,4 L8,0" Stroke="#94A3B8" StrokeThickness="1.5"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,1,10,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="#F0101820" BorderBrush="{StaticResource Accent}"
                                        BorderThickness="1" CornerRadius="8" Margin="0,4,8,8" Padding="4"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.14" Color="#0F172A"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="240">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="10,7">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSubtle}"/>
                                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 文本框 -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{StaticResource FieldBg}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次级按钮 -->
        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBg}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A2834"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 模式卡片（单选） -->
        <Style x:Key="ModeCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="mode"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#B010161E" BorderBrush="#334155"
                                BorderThickness="1" CornerRadius="8" Padding="8,4" MinHeight="40"
                                VerticalAlignment="Stretch">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.25" Color="#22D3EE"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="chip" Width="26" Height="26" CornerRadius="4" Background="#122028"
                                        VerticalAlignment="Center">
                                    <ContentControl x:Name="icon" Content="{TemplateBinding Tag}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="title" Text="{TemplateBinding Content}" FontSize="14"
                                               FontWeight="Regular" Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSubtle}"/>
                                <Setter TargetName="chip" Property="Background" Value="#134E4A"/>
                                <Setter TargetName="title" Property="Foreground" Value="{StaticResource Accent}"/>
                                <Setter TargetName="title" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="box" Width="18" Height="18" CornerRadius="5"
                                    BorderBrush="#334155" BorderThickness="1.5" Background="#0C141C"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="mark" Text="✓" FontSize="12" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed" Margin="0,-1,0,0"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnRecord" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource Brand}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="#D00B1218" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.28" Color="#22D3EE"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0122430"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0061018"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 图标（矢量 Path，20×20 视区，线宽 1.5） -->
        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource TextSecondary}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
        </Style>
        <Canvas x:Key="IconMonitor" Width="20" Height="20">
            <Path Style="{StaticResource Icon}" Data="M2,3 H18 V14 H2 Z"/>
            <Path Style="{StaticResource Icon}" Data="M8,17 H12 M10,14 V17"/>
        </Canvas>
        <Canvas x:Key="IconCrop" Width="20" Height="20">
            <Path Style="{StaticResource Icon}" Data="M3,7 V3 H7 M13,3 H17 V7 M17,13 V17 H13 M7,17 H3 V13"/>
        </Canvas>
        <Canvas x:Key="IconWindow" Width="20" Height="20">
            <Path Style="{StaticResource Icon}" Data="M2,4 H18 V16 H2 Z M2,8 H18"/>
            <Path Style="{StaticResource Icon}" Data="M14,6 h0.01 M16.5,6 h0.01" StrokeThickness="2.2"/>
        </Canvas>
    </Window.Resources>

    <Grid>
        <Image Source="/Assets/hud-bg.png" Stretch="UniformToFill"/>
        <Border BorderBrush="#3322D3EE" BorderThickness="1">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自定义标题栏：华文隶书名称紧挨窗口按钮 -->
        <Grid Grid.Row="0" Background="#F205070C" MouseLeftButtonDown="Caption_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Image x:Name="CaptionMark" Width="16" Height="16" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="Fant"/>
                <TextBlock Text="QSrcRecorder" FontFamily="华文隶书" FontSize="16" FontWeight="Normal"
                           Foreground="#E7F6FF" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="46" Height="32" Cursor="Hand" Click="Minimize_Click" ToolTip="最小化">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent">
                                <TextBlock Text="—" Foreground="#E7F6FF" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1A22D3EE"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Width="46" Height="32" Cursor="Hand" Click="CloseWindow_Click" ToolTip="关闭">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent">
                                <TextBlock Text="✕" Foreground="#E7F6FF" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#B91C1C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="14,6,14,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <RadioButton x:Name="ModeFull" Grid.Row="0" Style="{StaticResource ModeCard}" IsChecked="True"
                             Content="全屏录制" ToolTip="整个显示器" Tag="{StaticResource IconMonitor}" Checked="Mode_Changed"/>
                <RadioButton x:Name="ModeRegion" Grid.Row="1" Style="{StaticResource ModeCard}"
                             Content="区域录制" ToolTip="框选一块区域" Tag="{StaticResource IconCrop}" Checked="Mode_Changed"/>
                <RadioButton x:Name="ModeWindow" Grid.Row="2" Style="{StaticResource ModeCard}"
                             Content="窗口录制" ToolTip="指定应用窗口" Tag="{StaticResource IconWindow}" Checked="Mode_Changed"/>

                <!-- 录制来源 -->
                <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="录制来源"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="ScreenRow" Grid.Column="0" Grid.ColumnSpan="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="显示器"/>
                            <ComboBox x:Name="CboScreen"/>
                        </StackPanel>
                        <StackPanel x:Name="WindowRow" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="目标窗口"/>
                            <DockPanel>
                                <Button Style="{StaticResource BtnSecondary}" DockPanel.Dock="Right" Width="86"
                                        Content="选择…" Click="PickWindow_Click"/>
                                <Border Height="30" CornerRadius="6" Background="{StaticResource FieldBg}" Margin="0,0,8,0">
                                    <TextBlock x:Name="WindowName" Text="（未选择）" FontSize="12.5"
                                               Foreground="{StaticResource TextSecondary}"
                                               VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                    </StackPanel>
                </Border>

                <!-- 参数 -->
                <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="画质与编码"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="帧率"/>
                                <ComboBox x:Name="CboFps"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="分辨率"/>
                                <ComboBox x:Name="CboScale"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="画质"/>
                                <ComboBox x:Name="CboQuality"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="编码器"/>
                            <ComboBox x:Name="CboEncoder"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="5" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="保存位置"/>
                        <DockPanel>
                            <Button Style="{StaticResource BtnSecondary}" DockPanel.Dock="Right" Width="86"
                                    VerticalAlignment="Top"
                                    Content="浏览…" Click="Browse_Click"/>
                            <TextBox x:Name="TxtFolder" Margin="0,0,10,0" BorderBrush="{StaticResource FieldBorder}"
                                     FontFamily="Times New Roman, 华文中宋" FontSize="13"
                                     TextChanged="TxtFolder_TextChanged" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                                     TextWrapping="Wrap" Height="Auto" MinHeight="32"
                                     Padding="10,6" VerticalContentAlignment="Center" AcceptsReturn="False"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="声音与画面"/>
                        <StackPanel>
                            <CheckBox x:Name="ChkAudioRecord" Content="同时录制麦克风声音" FontSize="12.5"
                                      Foreground="{StaticResource TextPrimary}" Cursor="Hand"
                                      Checked="AudioRecord_Changed" Unchecked="AudioRecord_Changed"/>
                            <TextBlock x:Name="AudioStatusText" FontSize="11.5" Margin="0,4,0,0"
                                       Foreground="{StaticResource TextTertiary}" Visibility="Collapsed"/>
                            <CheckBox x:Name="ChkSystemAudioRecord" Content="同时录制系统声音" FontSize="12.5"
                                      Foreground="{StaticResource TextPrimary}" Cursor="Hand" Margin="0,6,0,0"
                                      Checked="SystemAudioRecord_Changed" Unchecked="SystemAudioRecord_Changed"/>
                            <!-- 音效调节折叠开关 -->
                            <DockPanel Margin="0,8,0,0">
                                <Button x:Name="BtnAudioEffectToggle" Style="{StaticResource BtnSecondary}"
                                        DockPanel.Dock="Right" Height="26" Width="70" Padding="0"
                                        Click="AudioEffectToggle_Click">
                                    <TextBlock x:Name="AudioEffectToggleText" Text="音效 ▾" FontSize="11.5"/>
                                </Button>
                                <TextBlock Text="音效调节" FontSize="12" Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <!-- 音效面板（默认收起，点击展开） -->
                            <Border x:Name="AudioEffectPanel" BorderBrush="{StaticResource FieldBorder}"
                                    BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,6,0,0"
                                    Background="#CC0C141C" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- 麦克风列 -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="麦克风" FontSize="11.5" Foreground="{StaticResource TextSecondary}"
                                                       Margin="0,0,0,3"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="SldMicVolume" Minimum="0.1" Maximum="5.0" Value="1.0"
                                                        TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,0,6,0"
                                                        Height="22" VerticalAlignment="Center" SmallChange="0.1" LargeChange="0.5"/>
                                                <TextBlock x:Name="MicVolText" Grid.Column="1" Text="音量 1.0×" FontSize="11"
                                                           Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="降噪门" FontSize="11" Foreground="{StaticResource TextTertiary}"
                                                           Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                <CheckBox x:Name="ChkMicNoiseGate" Content="开" FontSize="11.5"
                                                          Foreground="{StaticResource TextPrimary}" Cursor="Hand"
                                                          Checked="MicNoiseGate_Changed" Unchecked="MicNoiseGate_Changed"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- 系统声音列 -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="系统声音" FontSize="11.5" Foreground="{StaticResource TextSecondary}"
                                                       Margin="0,0,0,3"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="SldSysVolume" Minimum="0.1" Maximum="5.0" Value="1.0"
                                                        TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,0,6,0"
                                                        Height="22" VerticalAlignment="Center" SmallChange="0.1" LargeChange="0.5"/>
                                                <TextBlock x:Name="SysVolText" Grid.Column="1" Text="音量 1.0×" FontSize="11"
                                                           Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="低音" FontSize="11" Foreground="{StaticResource TextTertiary}"
                                                           Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                <Button x:Name="BtnBassDown" Style="{StaticResource BtnSecondary}" Content="−" Width="26" Height="26" Padding="0"
                                                        FontSize="13" Click="BtnBassDown_Click"/>
                                                <TextBlock x:Name="SysBassText" Text="0" FontSize="11" Width="16"
                                                           Foreground="{StaticResource TextSecondary}" TextAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <Button x:Name="BtnBassUp" Style="{StaticResource BtnSecondary}" Content="+" Width="26" Height="26" Padding="0"
                                                        FontSize="13" Click="BtnBassUp_Click"/>
                                                <TextBlock Text="高音" FontSize="11" Foreground="{StaticResource TextTertiary}"
                                                           Margin="8,0,3,0" VerticalAlignment="Center"/>
                                                <Button x:Name="BtnTrebleDown" Style="{StaticResource BtnSecondary}" Content="−" Width="26" Height="26" Padding="0"
                                                        FontSize="13" Click="BtnTrebleDown_Click"/>
                                                <TextBlock x:Name="SysTrebleText" Text="0" FontSize="11" Width="16"
                                                           Foreground="{StaticResource TextSecondary}" TextAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <Button x:Name="BtnTrebleUp" Style="{StaticResource BtnSecondary}" Content="+" Width="26" Height="26" Padding="0"
                                                        FontSize="13" Click="BtnTrebleUp_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <!-- 摄像头人像画中画 -->
                        <StackPanel Margin="0,10,0,0">
                            <CheckBox x:Name="ChkWebcam" Content="同时录制摄像头人像" FontSize="12.5"
                                      Foreground="{StaticResource TextPrimary}" Cursor="Hand"
                                      Checked="Webcam_Changed" Unchecked="Webcam_Changed"/>
                            <StackPanel x:Name="WebcamOptionsPanel" Margin="2,6,0,0" Visibility="Collapsed">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="设备" FontSize="11.5" Foreground="{StaticResource TextSecondary}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="CboWebcamDevice" Grid.Column="1" Height="26" FontSize="12"
                                              SelectionChanged="WebcamOption_Changed"/>
                                </Grid>
                                <TextBlock Margin="0,2,0,0" FontSize="11.5" Foreground="{StaticResource TextTertiary}" TextWrapping="Wrap"
                                           Text="拖动预览窗口调整位置，拖拽四边或四角调整大小"/>
                                <CheckBox x:Name="ChkWebcamMirror" Content="水平镜像" FontSize="12"
                                          Foreground="{StaticResource TextPrimary}" Cursor="Hand"
                                          Checked="WebcamOption_Changed" Unchecked="WebcamOption_Changed"/>
                                <TextBlock x:Name="WebcamStatusText" FontSize="11" Margin="0,4,0,0"
                                           Foreground="{StaticResource TextTertiary}" TextWrapping="Wrap"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0">
                            <CheckBox x:Name="ChkMouseHighlight" Content="鼠标跟随圆（常驻高亮）" FontSize="12.5"
                                      Foreground="{StaticResource TextPrimary}" Cursor="Hand" Margin="0,0,0,6"
                                      Checked="MouseHighlight_Changed" Unchecked="MouseHighlight_Changed"/>
                            <CheckBox x:Name="ChkClickHighlight" Content="鼠标点击高亮" FontSize="12.5"
                                      Foreground="{StaticResource TextPrimary}" Cursor="Hand"
                                      Checked="ClickHighlight_Changed" Unchecked="ClickHighlight_Changed"/>
                            <StackPanel x:Name="ColorRow" Margin="2,8,0,0">
                                <DockPanel>
                                    <Button x:Name="BtnColorToggle" Style="{StaticResource BtnSecondary}" Height="26"
                                            DockPanel.Dock="Left" Padding="10,0" Click="ColorToggle_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="ColorDot" Width="12" Height="12" CornerRadius="6"
                                                    BorderBrush="#E2E8F0" BorderThickness="1" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ColorToggleText" Text="颜色 ▾" FontSize="12"
                                                       Foreground="{StaticResource TextPrimary}" Margin="7,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- 常用色：常驻显示，点击即用 -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="Preset1" Tag="#DC2626" Background="#DC2626" Click="Preset_Click" Cursor="Hand"
                                                Width="20" Height="20" Margin="8,0,5,0" ToolTip="#DC2626 红" BorderBrush="#E2E8F0" BorderThickness="1.5">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderThickness="1.5"
                                                            BorderBrush="{TemplateBinding BorderBrush}"/>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button x:Name="Preset2" Tag="#F97316" Background="#F97316" Click="Preset_Click" Cursor="Hand"
                                                Width="20" Height="20" Margin="0,0,5,0" ToolTip="#F97316 橙" BorderBrush="#E2E8F0" BorderThickness="1.5">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderThickness="1.5"
                                                            BorderBrush="{TemplateBinding BorderBrush}"/>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button x:Name="Preset3" Tag="#FACC15" Background="#FACC15" Click="Preset_Click" Cursor="Hand"
                                                Width="20" Height="20" Margin="0,0,5,0" ToolTip="#FACC15 黄" BorderBrush="#E2E8F0" BorderThickness="1.5">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderThickness="1.5"
                                                            BorderBrush="{TemplateBinding BorderBrush}"/>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button x:Name="Preset4" Tag="#22C55E" Background="#22C55E" Click="Preset_Click" Cursor="Hand"
                                                Width="20" Height="20" Margin="0,0,5,0" ToolTip="#22C55E 绿" BorderBrush="#E2E8F0" BorderThickness="1.5">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderThickness="1.5"
                                                            BorderBrush="{TemplateBinding BorderBrush}"/>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button x:Name="Preset5" Tag="#06B6D4" Background="#06B6D4" Click="Preset_Click" Cursor="Hand"
                                                Width="20" Height="20" Margin="0,0,5,0" ToolTip="#06B6D4 青" BorderBrush="#E2E8F0" BorderThickness="1.5">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderThickness="1.5"
                                                            BorderBrush="{TemplateBinding BorderBrush}"/>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button x:Name="Preset6" Tag="#3B82F6" Background="#3B82F6" Click="Preset_Click" Cursor="Hand"
                                                Width="20" Height="20" Margin="0,0,5,0" ToolTip="#3B82F6 蓝" BorderBrush="#E2E8F0" BorderThickness="1.5">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderThickness="1.5"
                                                            BorderBrush="{TemplateBinding BorderBrush}"/>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button x:Name="Preset7" Tag="#8B5CF6" Background="#8B5CF6" Click="Preset_Click" Cursor="Hand"
                                                Width="20" Height="20" Margin="0,0,5,0" ToolTip="#8B5CF6 紫" BorderBrush="#E2E8F0" BorderThickness="1.5">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderThickness="1.5"
                                                            BorderBrush="{TemplateBinding BorderBrush}"/>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button x:Name="Preset8" Tag="#111827" Background="#111827" Click="Preset_Click" Cursor="Hand"
                                                Width="20" Height="20" ToolTip="#111827 黑" BorderBrush="#E2E8F0" BorderThickness="1.5">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderThickness="1.5"
                                                            BorderBrush="{TemplateBinding BorderBrush}"/>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                                <wpf:ColorWheelControl x:Name="ColorWheel" Margin="0,10,0,0"
                                                       ColorChanged="ColorWheel_ColorChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
        </Grid>

        <!-- 页脚：链接在左，录制按钮靠右下，旁边放一枚小图标 -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center">
                <Hyperlink x:Name="OpenFolderLink" Foreground="{StaticResource Accent}" TextDecorations="None"
                           Click="OpenFolder_Click" Cursor="Hand">打开输出文件夹</Hyperlink>
            </TextBlock>
            <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="12,0,12,0" FontSize="11.5" Foreground="{StaticResource TextTertiary}"
                       Text="F9 开始 / 停止　·　F10 暂停 / 继续　·　v0.1.4"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Image x:Name="CornerMark" Width="16" Height="16" Opacity="0.55" Margin="0,0,8,0"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant"/>
                <Button x:Name="RecordButton" Style="{StaticResource BtnRecord}" Click="RecordButton_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#22D3EE" Margin="0,0,6,0"/>
                        <TextBlock Text="开始录制" Foreground="#E7F6FF" FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        </Grid>
        </Grid>
        </Border>
    </Grid>
</Window>
